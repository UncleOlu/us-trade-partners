{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://us-trade-partners.local/schema/section.schema.json",
  "title": "data/<snapshot_id>/section/<id>.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "section",
    "years"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "snapshot_id": {
      "$ref": "common.schema.json#/$defs/SnapshotId"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "chapters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "I",
            "II",
            "III",
            "IV",
            "V",
            "VI",
            "VII",
            "VIII",
            "IX",
            "X",
            "XI",
            "XII",
            "XIII",
            "XIV",
            "XV",
            "XVI",
            "XVII",
            "XVIII",
            "XIX",
            "XX",
            "XXI",
            "SPECIAL"
          ]
        },
        "name": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          }
        }
      }
    },
    "years": {
      "type": "array",
      "description": "sorted by year",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "universe",
          "partners"
        ],
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 2010,
            "maximum": 2100
          },
          "universe": {
            "description": "sums over the reconciliation universe only",
            "allOf": [
              {
                "$ref": "common.schema.json#/$defs/FlowsWithDerived"
              }
            ]
          },
          "partners": {
            "type": "array",
            "description": "approved partners including EU with kind aggregate, sorted by code; the UI ranks",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "name",
                "kind",
                "include_in_world_reconciliation",
                "imports",
                "exports",
                "balance",
                "total_trade_value"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^([0-9]{4}|EU)$",
                  "description": "Census CTY_CODE (4 digits) or EU for the computed aggregate. The world row - is never a partner."
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "$ref": "common.schema.json#/$defs/Kind"
                },
                "include_in_world_reconciliation": {
                  "type": "boolean"
                },
                "imports": {
                  "$ref": "common.schema.json#/$defs/FlowValue"
                },
                "exports": {
                  "$ref": "common.schema.json#/$defs/FlowValue"
                },
                "balance": {
                  "$ref": "common.schema.json#/$defs/DerivedValue"
                },
                "total_trade_value": {
                  "$ref": "common.schema.json#/$defs/DerivedValue"
                }
              }
            }
          }
        }
      }
    }
  }
}
