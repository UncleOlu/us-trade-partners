{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://us-trade-partners.local/schema/meta.schema.json",
  "title": "data/<snapshot_id>/meta.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "code_commit",
    "model_ids",
    "raw_manifest_hash",
    "fetched_at",
    "source_last_update",
    "source_fingerprint",
    "latest_period",
    "documented_availability",
    "verified_availability",
    "configured_coverage",
    "eu_definition",
    "country_map_version",
    "hs_sections_version",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "snapshot_id": {
      "$ref": "common.schema.json#/$defs/SnapshotId"
    },
    "code_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "model_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestrator",
        "subagents"
      ],
      "properties": {
        "orchestrator": {
          "type": "string"
        },
        "subagents": {
          "type": "string"
        }
      }
    },
    "raw_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "acquisition start, UTC; reused verbatim on rebuild"
    },
    "source_last_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imports",
        "exports",
        "verified"
      ],
      "properties": {
        "imports": {
          "type": "string"
        },
        "exports": {
          "type": "string"
        },
        "verified": {
          "const": false
        }
      },
      "description": "observed LAST_UPDATE literal per endpoint; returns 0 as of 2026-09 and is not verified as a date"
    },
    "source_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_period",
        "world_totals_sha256",
        "before_equals_after"
      ],
      "properties": {
        "latest_period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "imports",
            "exports"
          ],
          "properties": {
            "imports": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$"
            },
            "exports": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$"
            }
          }
        },
        "world_totals_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the sorted JSON of world-total _YR values for every verified year, both flows"
        },
        "before_equals_after": {
          "const": true
        }
      }
    },
    "latest_period": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "documented_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_year",
        "source"
      ],
      "properties": {
        "from_year": {
          "type": "integer",
          "minimum": 2010,
          "maximum": 2100
        },
        "source": {
          "type": "string"
        }
      }
    },
    "verified_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_year",
        "to_year",
        "probes_file"
      ],
      "properties": {
        "from_year": {
          "type": "integer",
          "minimum": 2010,
          "maximum": 2100
        },
        "to_year": {
          "type": "integer",
          "minimum": 2010,
          "maximum": 2100
        },
        "probes_file": {
          "type": "string"
        }
      }
    },
    "configured_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_year",
        "end_year",
        "years"
      ],
      "properties": {
        "start_year": {
          "type": "integer",
          "minimum": 2010,
          "maximum": 2100
        },
        "end_year": {
          "type": "integer",
          "minimum": 2010,
          "maximum": 2100
        },
        "years": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2010,
            "maximum": 2100
          },
          "uniqueItems": true
        }
      }
    },
    "eu_definition": {
      "type": "string"
    },
    "country_map_version": {
      "type": "string"
    },
    "hs_sections_version": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
