.venv/
node_modules/
dist/
.env
*.env
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
# raw archives are published as zipped GitHub Release artifacts with their manifest, not committed
raw/
# staged and rebuild-check builds are transient; the published snapshot lives under data/
reports/pipeline/staging/
reports/pipeline/rebuild_check/
.venv-tests/
tests/.pytest_cache/
# release zips are uploaded as GitHub Release assets, not committed
reports/pipeline/releases/
# published snapshots live as GitHub Release assets; the deploy workflow fetches them by id
data/
# full validation report ships inside the release zip; the summary stays in git
reports/pipeline/validation.csv

# Incremental TypeScript build state is machine-local.
*.tsbuildinfo

# Offline verification builds are not publication source.
reports/pipeline/final_build_a/
reports/pipeline/final_build_b/
